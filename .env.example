# ── 복사해서 backend/.env 로 사용 ──────────────────────────
# copy .env.example backend\.env

# DB (docker-compose 기본값과 일치)
DATABASE_URL=postgresql+psycopg://wayfinder:wayfinder@localhost:5432/wayfinder
# DB 연결 시도 상한(초). DB가 꺼져 있을 때 요청이 멈추지 않고 이 시간 안에 502로 끝난다
# DB_CONNECT_TIMEOUT_SECONDS=5

# LLM — 역량 분해·진단·로드맵 생성. 로컬 모델(Ollama)만 사용, 키 불필요
# https://ollama.com 설치 후 `ollama pull qwen3.5:4b`. CPU에서는 단계당 수 분~15분 걸림
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:4b
# OLLAMA_TIMEOUT_SECONDS=1800
# 같은 입력의 LLM 결과 캐시(SQLite). 비우면 캐시 끔. 기본: backend/.cache/llm_cache.sqlite
# LLM_CACHE_PATH=
# 캐시 보존 기한(시간). 값에 경력 서사에서 뽑은 근거 문장이 들어가므로 기한이 지나면 지운다
# LLM_CACHE_TTL_HOURS=24
# 임베딩은 로컬 모델(BAAI/bge-m3, 1024차원) — API 키 불필요. 첫 실행 시 모델(약 2GB) 자동 다운로드
# EMBED_BATCH_SIZE: data-pipeline 배치 임베딩 크기(기본 16, 메모리 여유에 따라 조정)

# 공공데이터 API 키
# WORK24_API_KEY: work24.go.kr 채용정보 API 신청 시 발급 (개인회원은 채용행사·공채속보·공채기업정보만 이용 가능)
WORK24_API_KEY=
# HRDNET_API_KEY: work24.go.kr 국민내일배움카드 훈련과정 API 신청 시 별도 발급된 키
HRDNET_API_KEY=
# NCS_API_KEY: data.go.kr "한국산업인력공단_NCS 관련 정보 서비스" 활용신청 후 일반 인증키(Decoding)
NCS_API_KEY=
# SEOUL_JOB_API_KEY: data.seoul.go.kr "서울시 일자리포털 채용 정보"(OA-23047 recMntList) 인증키
SEOUL_JOB_API_KEY=
# GG_JOBA_API_KEY: data.gg.go.kr(경기데이터드림) "경기도일자리재단 잡아바 채용정보" 인증키
GG_JOBA_API_KEY=

# 앱 설정
APP_ENV=dev
CORS_ORIGINS=http://localhost:5173
